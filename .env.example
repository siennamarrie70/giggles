# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# The cloud gets the same keys: Vercel (the dashboard) in Project > Settings > Environment Variables;
# GitHub Actions (the morning run) in the repository's Settings > Secrets and variables > Actions.

# Gemini, free tier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the first model tried (see tools/llm.py)
GEMINI_MODEL=

# YouTube: written for you by `python tools/youtube_auth.py` (or the dashboard's Channels page)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Reels: your Meta app's ID and secret; the rest is written by the dashboard's Channels page
# when you connect (workflows/setup_accounts.md)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# Database: the cloud database's connection string (Aiven since 2026-11-15). Leave empty locally to use .tmp/ezzy.db
DATABASE_URL=

# A long random string (32+ characters): /api/health answers only a request that sends it as
# "Authorization: Bearer <CRON_SECRET>". It also locks the dashboard's sign-in cookies (a stolen one can't be
# used to guess the password); changing it signs every browser out. Claude can make one.
CRON_SECRET=
# The cloud's Reels: a long random string (32+ characters) that encrypts the short versions kept between GitHub runs
# (tools/kept.py); GitHub's secrets need it, this computer doesn't. Claude can make one.
REELS_KEY=
# Your own words are kept encrypted in prompts/*.enc (your description of the look, and your script writer's prompt),
# because the repository is public: a long random string (32+ characters) that opens them (tools/prompts.py). Here and
# in GitHub's secrets.
PROMPTS_KEY=
# Autopilot switch (also the dashboard's header switch): true stops automatic posting and every
# automatic job until you set it back to false. Writing and uploads you start yourself still work.
PAUSED=true
# The dashboard's sign-in page (/login): a username, and a password of 12 characters or more that is hard
# to guess (zxcvbn's top score, 4 of 4: four or five unrelated words work well; your channel's name plus a
# year doesn't). A shorter or guessable one keeps the dashboard off and says why. Ten wrong tries lock that
# address out for ten minutes (thirty from everywhere rest sign-in for ten). A browser stays signed in for
# 30 days; a new password signs every browser out. In the cloud (Vercel) both are needed, or the dashboard
# stays off. Here they're optional (the dashboard only answers on this computer): with both set, this
# computer's dashboard asks for them too.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Phone alerts (optional): token from @BotFather, and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
