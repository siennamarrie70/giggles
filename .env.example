# Copy to .env and fill in. Never commit .env.
# The same keys go into Vercel: Project > Settings > Environment Variables.

# Gemini, free tier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the first model tried (see tools/llm.py)
GEMINI_MODEL=

# Stock footage for the cute-animal version only; the cartoons don't use these
PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube: written for you by `python tools/youtube_auth.py`
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Database: Vercel sets this when you connect Neon. Leave empty locally to use .tmp/ezzy.db
DATABASE_URL=

# Cloud jobs: a long random string; Vercel Cron sends it with every scheduled call
CRON_SECRET=
# Autopilot switch (also the dashboard's header switch): true stops automatic posting and every
# automatic job until you set it back to false. Writing and uploads you start yourself still work.
PAUSED=true
# Cloud dashboard only (Vercel): the password your browser asks for. Empty = dashboard off in the cloud.
# Locally the dashboard needs no password; it only answers on this computer.
DASHBOARD_PASSWORD=

# Phone alerts (optional): token from @BotFather, and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
