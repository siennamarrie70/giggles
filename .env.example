# Copy to .env and fill in. Never commit .env (it's in .gitignore).
# The cloud gets the same keys: Vercel (the dashboard) in Project > Settings > Environment Variables;
# GitHub Actions (the morning run) in the repository's Settings > Secrets and variables > Actions.

# Gemini, free tier (no card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the first model tried (see tools/llm.py)
GEMINI_MODEL=

# Stock footage (the footage look): free keys from pexels.com/api and pixabay.com/api/docs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# The drawn look's scenes (tools/draw.py): Cloudflare's free Workers AI. Account ID, and a
# "Workers AI" API token (dash.cloudflare.com > AI > Workers AI > Use REST API)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# YouTube: written for you by `python tools/youtube_auth.py` (or the dashboard's Channels page)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Reels: your Meta app's ID and secret; the rest is written by the dashboard's Channels page
# when you connect (workflows/setup_accounts.md)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# Database: Neon's connection string in the cloud. Leave empty locally to use .tmp/ezzy.db
DATABASE_URL=

# A long random string (32+ characters): /api/health and /api/cron/* answer only a request that sends it
# as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# The cloud's Reels: a long random string (32+ characters) that encrypts the videos kept between GitHub runs
# (tools/kept.py); GitHub's secrets need it, this computer doesn't. Claude can make one.
REELS_KEY=
# Autopilot switch (also the dashboard's header switch): true stops automatic posting and every
# automatic job until you set it back to false. Writing and uploads you start yourself still work.
PAUSED=true
# Cloud dashboard only (Vercel): the password your browser asks for, 12 characters or more (a shorter
# one keeps the dashboard off; ten wrong tries lock that address out for ten minutes). Empty = dashboard
# off in the cloud. Locally the dashboard needs no password; it only answers on this computer.
DASHBOARD_PASSWORD=

# Phone alerts (optional): token from @BotFather, and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
